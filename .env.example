# Local Vinext/Hyperdrive connection. Do not commit the real .env file.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=mysql://user:password@127.0.0.1:3306/wedding

# Use at least 32 random characters in every environment.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

